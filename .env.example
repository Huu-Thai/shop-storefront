# Base URL of the shop API (no trailing /api/v1). Server-side only — never exposed to the browser.
SHOP_API_URL=http://localhost:3000

# Encrypts the customer session cookie (≥ 32 characters). Generate one with:  openssl rand -base64 48
# Changing it signs every customer out.
SESSION_SECRET=

# Store served at the site root. Other stores of its website are served at their baseUrl (set in
# Shop Admin → Stores) or under /<store-code>.
DEFAULT_STORE=us-en

# Optional: more stores to serve, e.g. stores of another website, comma-separated.
# STORES=vn-vi

# Optional: public origin for absolute URLs. Needed for sitemaps, hreflang and absolute canonicals.
# SITE_URL=https://shop.example.com

# Optional: secret of the shop webhook that keeps caches fresh. In Shop Admin → System → Webhooks,
# add a webhook to <your site>/api/revalidate with the events listed in README.md ("Keeping pages
# fresh") and paste its signing secret here.
# WEBHOOK_SECRET=

# Optional, build time: image origins that aren't https (dev MinIO signed links), comma-separated.
# MEDIA_ORIGINS=http://localhost:9200

# Optional: demo mode for showcase installs. Browsing and the cart work; orders, registration and
# account changes are refused, and a banner with the accent colour picker is shown.
# DEMO_MODE=true
