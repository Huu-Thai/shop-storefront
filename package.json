{
  "name": "shop-storefront",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Storefront theme for the shop headless commerce API",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build && node scripts/standalone-assets.mjs",
    "start": "node .next/standalone/server.js -p 3002",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "api:types": "openapi-typescript ${SHOP_OPENAPI:-../shop/openapi/shop-api.json} -o src/server/shop-api.d.ts --root-types=false",
    "test:e2e": "playwright test",
    "notices": "license-checker-rseidelsohn --production --json | node scripts/notices.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "package": "node scripts/package.mjs",
    "lcp": "node scripts/lcp.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.1",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "license-checker-rseidelsohn": "^4.4.2",
    "lighthouse": "^13.5.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
